# 백엔드 환경변수 — 변수명만 둔다. 실제 값이 든 .env 는 커밋 금지.
# 배포 환경 변수는 infra/.env.example 이 원천이며 여기와 이름을 맞춘다.

SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ddubi
MYSQL_USER=ddubi
MYSQL_PASSWORD=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# HS256 기준 최소 32바이트. 운영에서 비워두지 말 것.
JWT_SECRET=

# --- 외부 API ---
KAKAO_REST_API_KEY=

# --- 서울 교통 마스터 관리 적재 ---
# 일반 실행은 false. 공식 XLSX/CSV를 새 data-version으로 적재하는 관리 실행에서만 true.
DDUBI_TRANSIT_MASTER_IMPORT_ENABLED=false
DDUBI_TRANSIT_MASTER_DATA_VERSION=
DDUBI_TRANSIT_MASTER_BUS_WORKBOOK=
DDUBI_TRANSIT_MASTER_SUBWAY_TIMETABLE=
DDUBI_TRANSIT_MASTER_SUBWAY_REALTIME_STATIONS=
DDUBI_TRANSIT_MASTER_ALIASES=

# BUS path 첫·끝과 공식 정류장 사이 EXACT 허용 반경(m). 실제 검증셋으로 조정한다.
DDUBI_BUS_MAPPING_MAX_ENDPOINT_DISTANCE_METERS=150
DDUBI_TRANSIT_MAPPING_REFRESH_INTERVAL_MS=60000
