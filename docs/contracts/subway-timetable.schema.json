{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DDUBI normalized dated subway timetable",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "masterDataVersion", "source", "publishedAt", "validFrom", "validUntil", "trips"],
  "properties": {
    "version": {"$ref": "#/$defs/text"},
    "masterDataVersion": {"$ref": "#/$defs/text"},
    "source": {"$ref": "#/$defs/text"},
    "publishedAt": {"$ref": "#/$defs/time"},
    "validFrom": {"$ref": "#/$defs/time"},
    "validUntil": {"$ref": "#/$defs/time"},
    "trips": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/trip"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "providerId": {"type": "string", "pattern": "^[0-9A-Za-z_-]{1,60}$"},
    "time": {"type": "string", "format": "date-time"},
    "call": {
      "type": "object", "additionalProperties": false,
      "required": ["stationId", "providerStationId", "arrivalAt", "departureAt", "stops"],
      "properties": {
        "stationId": {"$ref": "#/$defs/text"},
        "providerStationId": {"$ref": "#/$defs/providerId"},
        "arrivalAt": {"$ref": "#/$defs/time"},
        "departureAt": {"$ref": "#/$defs/time"},
        "stops": {"type": "boolean"}
      }
    },
    "trip": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "lineId", "providerLineId", "direction", "trainId", "arrivalDirection", "positionDirection", "arrivalDestination", "positionDestination", "trainType", "serviceDate", "calls"],
      "properties": {
        "key": {"$ref": "#/$defs/text"},
        "lineId": {"$ref": "#/$defs/text"},
        "providerLineId": {"$ref": "#/$defs/providerId"},
        "direction": {"$ref": "#/$defs/text"},
        "trainId": {"$ref": "#/$defs/providerId"},
        "arrivalDirection": {"$ref": "#/$defs/text"},
        "positionDirection": {"$ref": "#/$defs/text"},
        "arrivalDestination": {"$ref": "#/$defs/text"},
        "positionDestination": {"$ref": "#/$defs/text"},
        "trainType": {"$ref": "#/$defs/text"},
        "serviceDate": {"type": "string", "format": "date"},
        "calls": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/call"}}
      }
    }
  }
}
