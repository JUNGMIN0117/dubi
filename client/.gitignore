# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# The repository root ignores runtime data directories. Flutter source files
# under lib/data are application code and must remain trackable.
!lib/data/
!lib/data/**

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase Android config is supplied locally and must not be committed.
/android/app/google-services.json

# Widget Preview related
.widget_preview/

# 저장소에 들여온 외부 패키지 사본의 잠금 파일. path 의존이라 앱의 잠금 파일이
# 기준이 되고 이 파일은 쓰이지 않는다. flutter 명령을 그 폴더에서 돌리면 생긴다.
packages/*/pubspec.lock
