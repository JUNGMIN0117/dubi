<?xml version="1.0"?>
<configuration>
  <property>
    <name>dfs.replication</name>
    <value>2</value>
  </property>
  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>
  <!-- compose 볼륨과 짝을 맞춘 저장 경로 -->
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>file:///hadoop/dfs/name</value>
  </property>
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>file:///hadoop/dfs/data</value>
  </property>
  <!-- 컨테이너 간 통신은 IP 대신 서비스 이름으로 -->
  <property>
    <name>dfs.namenode.datanode.registration.ip-hostname-check</name>
    <value>false</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-bind-host</name>
    <value>0.0.0.0</value>
  </property>
  <property>
    <name>dfs.namenode.http-bind-host</name>
    <value>0.0.0.0</value>
  </property>
  <!-- 데이터노드는 호스트명으로 등록·접근한다. 클라이언트가 받는 주소도 IP 가 아닌 호스트명 -->
  <property>
    <name>dfs.datanode.use.datanode.hostname</name>
    <value>true</value>
  </property>
  <property>
    <name>dfs.client.use.datanode.hostname</name>
    <value>true</value>
  </property>
  <!-- 데이터노드 사망 판정 단축 (2026-09-09, 9/7 장애 연습의 약점 보완).
       판정 시간 = recheck-interval x 2 + heartbeat(3s) x 10. 기본 5분이면 10분 30초, 30초로 두면 1분 30초.
       그동안 네임노드는 죽은 노드를 Live 로 알고 WebHDFS 읽기를 그 노드로 보내 실패시킨다 -->
  <property>
    <name>dfs.namenode.heartbeat.recheck-interval</name>
    <value>30000</value>
  </property>
  <!-- 심장박동이 30초(dfs.namenode.stale.datanode.interval 기본값) 끊긴 노드는 "stale" 로 표시된다.
       기본은 stale 노드도 읽기 대상에 넣지만, 켜 두면 읽기(WebHDFS 리다이렉트 포함)에서 뒤로 미룬다.
       쓰기 회피는 켜지 않는다: 데이터노드가 2대라 한 대를 피하면 복제 대상이 하나뿐이다 -->
  <property>
    <name>dfs.namenode.avoid.read.stale.datanode</name>
    <value>true</value>
  </property>
  <!-- archiver 가 쓰는 WebHDFS (NameNode 9870 → DataNode 9864 리다이렉트) -->
  <property>
    <name>dfs.webhdfs.enabled</name>
    <value>true</value>
  </property>
</configuration>
